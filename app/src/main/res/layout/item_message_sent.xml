<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="6dp"
    android:layout_gravity="end">

    <!-- 💬 Message Bubble Layout (Text + Reply + Time) -->
    <LinearLayout
        android:id="@+id/messageBubbleLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="360dp"
    android:orientation="vertical"
    android:layout_gravity="end"
    android:background="@drawable/message_bubble_sent"
    android:padding="0dp"
    android:visibility="visible">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@android:color/transparent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:orientation="vertical"
            android:layout_marginEnd="2dp"
            android:layout_gravity="end">

            <!-- 🧵 Reply preview -->
            <LinearLayout
                android:id="@+id/replyLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="6dp"
                android:background="@drawable/reply_background"
                android:visibility="gone"
                android:layout_marginBottom="4dp">

                <View
                    android:id="@+id/purpleBar"
                    android:layout_width="2dp"
                    android:layout_height="match_parent"
                    android:background="@color/purple_700" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="10dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:gravity="start">

                    <TextView
                        android:id="@+id/replySenderTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sender"
                        android:textColor="@color/purple_700"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:maxWidth="190dp" />

                    <TextView
                        android:id="@+id/replyMessageTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Message content"
                        android:textColor="@android:color/darker_gray"
                        android:textSize="13sp"
                        android:maxLines="3"
                        android:ellipsize="end"
                        android:maxWidth="190dp" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/replyImageContainer"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:orientation="horizontal"
                    android:layout_marginTop="5dp"
                    android:gravity="end"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/ic_admin" />
            </LinearLayout>

            <!-- 📝 Actual message -->
            <TextView
                android:id="@+id/textMessageBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#5A189A"
                android:textSize="16sp"
                android:lineSpacingExtra="2dp"
                android:maxWidth="340dp"
                android:minWidth="80dp"
                android:textIsSelectable="true"
                android:autoLink="web"
                android:ellipsize="end"
                android:maxLines="100" />

            <!-- 🕐 Time + Status -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_gravity="end"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/textMessageTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12:45"
                    android:textColor="#5A189A"
                    android:textSize="10sp"
                    android:layout_marginEnd="4dp" />

                <ImageView
                    android:id="@+id/imageMessageStatus"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_done_all"
                    app:tint="@color/white" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>

    <FrameLayout
        android:id="@+id/attachmentBubbleLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:padding="2dp"
        android:background="@drawable/message_bubble_sent"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/attachmentContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="0dp"
            android:layout_marginEnd="0dp" />

        <LinearLayout
            android:id="@+id/attachmentTimeStatusRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_gravity="end|bottom"
            android:layout_marginTop="0dp"
            android:layout_marginEnd="0dp"
            android:visibility="gone"
            android:padding="0dp">

            <TextView
                android:id="@+id/attachmentTimeOverlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12:45"
                android:textColor="#CCFFFFFF"
                android:textSize="11sp"
                android:shadowColor="#88000000"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="1"/>

            <ImageView
                android:id="@+id/attachmentStatusOverlay"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_done_all"
                app:tint="@android:color/white"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/timeOverlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="bottom|end"
            android:background="@drawable/overlay_bg"
            android:paddingStart="8dp"
            android:paddingEnd="12dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />
    </FrameLayout>

</FrameLayout>

